BOT_TOKEN=???               # tg bot token from @BotFather
LOGS_CHAT_ID=???            # chat id where the bot mirrors logs and summaries

# --- AI provider: set GEMINI_API_KEY to use Gemini, otherwise OpenRouter is used ---
GEMINI_API_KEY=???          # https://aistudio.google.com/apikey
GEMINI_MODEL_SUMMARY=gemini-3-flash-preview
GEMINI_MODEL_ASK=gemini-2.5-pro

OPENROUTER_API_KEY=???      # https://openrouter.ai/keys
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Schedule ---
SUMMARY_HOUR=10             # hour (0-23) to run the daily summary
SUMMARY_TZ=Europe/Moscow    # IANA tz used by the cron schedule
SUMMARY_PERIOD_HOURS=24     # how many hours back the summary covers
SUMMARY_DAILY_LIMIT=3       # max manual /summary calls per chat per day

# --- Storage ---
DB_PATH=mr-stat.db          # path to the sqlite database file
RETENTION_DAYS=3            # delete messages older than this many days

# --- Filtering ---
MIN_WORDS=10                # users with fewer words in the period are skipped