BOT_TOKEN=???               # tg bot token from @BotFather
LOGS_CHAT_ID=???            # chat id where the bot mirrors logs and summaries

# --- /summary provider: Freemodel / OpenAI-compatible API ---
FREEMODEL_API_KEY=???       # key from https://freemodel.dev/dashboard/keys
FREEMODEL_BASE_URL=https://api.freemodel.dev
FREEMODEL_MODEL=gpt-5.5

# Generic OpenAI-compatible override for /summary. If set, these take priority over Freemodel.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Legacy /summary fallback. Used only when OPENAI_* and FREEMODEL_* keys are empty.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
LLM_TIMEOUT_SECONDS=180

# --- /ask provider: Gemini ---
GEMINI_API_KEY=???          # https://aistudio.google.com/apikey
GEMINI_MODEL_ASK=gemma-4-31b-it

# Optional /summary override. Leave empty to use Freemodel/OpenAI-compatible summary.
GEMINI_MODEL_SUMMARY=

# --- Schedule ---
SUMMARY_HOUR=10             # hour (0-23) to run the daily summary
SUMMARY_TZ=Europe/Moscow    # IANA tz used by the cron schedule
SUMMARY_PERIOD_HOURS=24     # how many hours back the summary covers
SUMMARY_DAILY_LIMIT=3       # max manual /summary calls per chat per day

# --- Storage ---
DB_PATH=mr-stat.db          # path to the sqlite database file
RETENTION_DAYS=3            # delete messages older than this many days

# --- Filtering ---
MIN_WORDS=10                # users with fewer words in the period are skipped

# --- Access control (comma-separated ids; empty = unrestricted) ---
ALLOWED_CHAT_IDS=           # whitelist of group chat ids the bot reacts in
ALLOWED_USER_IDS=           # whitelist of user ids allowed to DM the bot
BLOCKED_USER_IDS=           # users whose events are silently dropped everywhere
SUDO_USER_IDS=              # users that bypass allowlists and /summary daily limit
